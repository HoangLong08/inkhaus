// INKHAUS - PostgreSQL schema
// Everything the storefront used to hard-code (catalog, clip art, price ladder)
// plus the parts that were never built: designs, orders, quotes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- catalog

enum GarmentType {
  TEE
  HOODIE
  LONGSLEEVE
  TANK
  CAP
  TOTE
  CREWNECK
}

enum PrintMethod {
  DTG
  SCREEN_PRINT
  EMBROIDERY
  PUFF
  LEATHER_PATCH
}

model Product {
  id     String      @id @default(cuid())
  slug   String      @unique
  name   String
  type   GarmentType
  blurb  String
  fabric String
  tag    String?

  /// price for a single unit, USD
  price     Decimal @db.Decimal(10, 2)
  /// hard floor - the 50+ unit price, discounts never go below it
  bulkPrice Decimal @db.Decimal(10, 2)

  methods PrintMethod[]

  /// print area in the garment SVG viewBox units
  printAreaX   Int
  printAreaY   Int
  printAreaW   Int
  printAreaH   Int
  /// the same area in the real world, inches - drives the DPI check
  printInchesW Decimal @db.Decimal(6, 2)
  printInchesH Decimal @db.Decimal(6, 2)

  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  colors     ProductColor[]
  designs    Design[]
  orderItems OrderItem[]
  quotes     BulkQuote[]
  reviews    Review[]

  @@index([active, sortOrder])
  @@map("products")
}

model Color {
  id        String  @id @default(cuid())
  slug      String  @unique
  name      String
  hex       String
  /// true when the garment is dark enough that artwork needs light ink
  dark      Boolean @default(false)
  sortOrder Int     @default(0)

  products   ProductColor[]
  designs    Design[]
  orderItems OrderItem[]

  @@map("colors")
}

model ProductColor {
  productId String
  colorId   String
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  color   Color   @relation(fields: [colorId], references: [id], onDelete: Cascade)

  @@id([productId, colorId])
  @@map("product_colors")
}

model Size {
  id    String @id @default(cuid())
  code  String @unique
  label String
  /// blank upcharge per unit, added on top of the tier price
  upcharge  Decimal @default(0) @db.Decimal(10, 2)
  sortOrder Int     @default(0)

  @@map("sizes")
}

model PriceTier {
  id     String @id @default(cuid())
  /// quantity at which this tier kicks in
  minQty Int    @unique
  /// fraction off list, 0..1
  discount Decimal @db.Decimal(4, 3)

  @@map("price_tiers")
}

// ------------------------------------------------------------ studio assets

model Clipart {
  id   String   @id @default(cuid())
  slug String   @unique
  name String
  tags String[]
  /// inline SVG, uses currentColor so the ink colour applies
  svg  String

  active    Boolean @default(true)
  sortOrder Int     @default(0)

  @@map("clipart")
}

model Font {
  id    String @id @default(cuid())
  label String @unique
  /// css font-family stack
  css   String

  sortOrder Int @default(0)

  @@map("fonts")
}

model InkColor {
  id        String @id @default(cuid())
  hex       String @unique
  name      String
  sortOrder Int    @default(0)

  @@map("ink_colors")
}

// ----------------------------------------------------------------- designs

model Design {
  id       String @id @default(cuid())
  /// short shareable id used in URLs
  publicId String @unique
  name     String @default("Untitled design")

  productId String
  colorId   String?

  /// fabric.js scene graph per side: { front: {...}, back: {...} }
  scene        Json
  /// data-url or object-storage key of the mockup preview
  previewFront String?
  previewBack  String?

  customerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id])
  color      Color?      @relation(fields: [colorId], references: [id])
  customer   Customer?   @relation(fields: [customerId], references: [id])
  orderItems OrderItem[]

  @@index([customerId])
  @@map("designs")
}

// ------------------------------------------------------------------ orders

model Customer {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  phone     String?
  company   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  designs Design[]
  orders  Order[]
  quotes  BulkQuote[]

  @@map("customers")
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  IN_PRODUCTION
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id     String      @id @default(cuid())
  /// database-side counter the human order number is formatted from
  seq    Int         @unique @default(autoincrement())
  /// human-facing order number, e.g. INK-000123
  number String      @unique
  status OrderStatus @default(DRAFT)

  customerId String

  subtotal Decimal @db.Decimal(10, 2)
  discount Decimal @default(0) @db.Decimal(10, 2)
  shipping Decimal @default(0) @db.Decimal(10, 2)
  tax      Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)
  currency String  @default("USD")

  shipName    String?
  shipLine1   String?
  shipLine2   String?
  shipCity    String?
  shipState   String?
  shipPostal  String?
  shipCountry String? @default("US")

  notes     String?
  placedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  customer Customer     @relation(fields: [customerId], references: [id])
  items    OrderItem[]
  events   OrderEvent[]

  @@index([customerId, createdAt])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String      @id @default(cuid())
  orderId   String
  productId String
  colorId   String
  designId  String?
  method    PrintMethod

  /// tier price for one unit, before size upcharges
  unitPrice Decimal @db.Decimal(10, 2)
  quantity  Int
  lineTotal Decimal @db.Decimal(10, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  color   Color           @relation(fields: [colorId], references: [id])
  design  Design?         @relation(fields: [designId], references: [id])
  sizes   OrderItemSize[]

  @@index([orderId])
  @@map("order_items")
}

/// one row per size in the size/quantity grid
model OrderItemSize {
  id       String  @id @default(cuid())
  itemId   String
  size     String
  quantity Int
  upcharge Decimal @default(0) @db.Decimal(10, 2)

  item OrderItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, size])
  @@map("order_item_sizes")
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_events")
}

// ------------------------------------------------------- bulk quotes & social

enum QuoteStatus {
  NEW
  CONTACTED
  WON
  LOST
}

model BulkQuote {
  id        String       @id @default(cuid())
  email     String
  name      String?
  company   String?
  productId String?
  quantity  Int
  method    PrintMethod?
  message   String?
  /// snapshot of what the calculator quoted, so a later price change is visible
  estimated Decimal?     @db.Decimal(10, 2)
  status    QuoteStatus  @default(NEW)

  customerId String?
  createdAt  DateTime @default(now())

  product  Product?  @relation(fields: [productId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([status, createdAt])
  @@map("bulk_quotes")
}

model Review {
  id        String   @id @default(cuid())
  author    String
  handle    String?
  rating    Int      @default(5)
  body      String
  productId String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())

  product Product? @relation(fields: [productId], references: [id])

  @@index([published, createdAt])
  @@map("reviews")
}
