{
  "extends": "./tsconfig.json",
  // `prisma` as a whole, not just seed.ts: the seeds are run by ts-node and
  // never belong in dist. Including even one of them widens TypeScript's
  // inferred rootDir to the package root, which silently moves the build from
  // dist/main.js to dist/src/main.js and breaks `npm run start`.
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts", "prisma"]
}
