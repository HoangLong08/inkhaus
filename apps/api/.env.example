# PostgreSQL - matches docker-compose.yml
DATABASE_URL="postgresql://inkhaus:inkhaus@localhost:5432/inkhaus?schema=public"

PORT=4000
API_PREFIX=api
NODE_ENV=development

# comma separated list of allowed browser origins. The admin app is NOT here on
# purpose: it calls this API server-to-server, so no browser origin needs a grant.
CORS_ORIGIN=http://localhost:4321

# how long an admin session token stays valid
ADMIN_SESSION_TTL_HOURS=12

# the first staff account, created by `npm run db:seed`. Leave blank to skip -
# nothing is seeded and no default password exists.
ADMIN_BOOTSTRAP_EMAIL=owner@inkhaus.test
ADMIN_BOOTSTRAP_PASSWORD=change-me-please

# order maths
SHIPPING_FLAT=6.5
FREE_SHIPPING_OVER=75
TAX_RATE=0
