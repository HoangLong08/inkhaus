# PostgreSQL - matches docker-compose.yml
DATABASE_URL="postgresql://inkhaus:inkhaus@localhost:5432/inkhaus?schema=public"

PORT=4000
API_PREFIX=api
NODE_ENV=development

# comma separated list of allowed browser origins. The admin app is NOT here on
# purpose: it calls this API server-to-server, so no browser origin needs a grant.
CORS_ORIGIN=http://localhost:4321

# how long an admin session token stays valid
ADMIN_SESSION_TTL_HOURS=12

# Sign-in is Google-only. This list IS the allowlist: `npm run db:seed` creates
# an OWNER row per address, and a Google account with no row here cannot get in.
ADMIN_BOOTSTRAP_EMAILS=hoangnguyenitvn@gmail.com,longnguyen.080400@gmail.com

# The OAuth client the admin app signs in with. Only used to check the `aud`
# claim of the id_token, so the API needs the id but never the secret.
GOOGLE_CLIENT_ID=

# Test-only escape hatch: points id-token verification at a local OIDC stub so
# the e2e suite can run without Google. Both are IGNORED when NODE_ENV is
# production (see src/config/configuration.ts) - verification aimed at someone
# else's issuer would make every forged token valid.
GOOGLE_ISSUER=
GOOGLE_JWKS_URL=

# order maths
SHIPPING_FLAT=6.5
FREE_SHIPPING_OVER=75
TAX_RATE=0
