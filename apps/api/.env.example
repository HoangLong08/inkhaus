# PostgreSQL - matches docker-compose.yml
DATABASE_URL="postgresql://inkhaus:inkhaus@localhost:5432/inkhaus?schema=public"

PORT=4000
API_PREFIX=api
NODE_ENV=development

# comma separated list of allowed browser origins
CORS_ORIGIN=http://localhost:4321

# shared secret for the back-office endpoints (order status, quote triage)
ADMIN_API_KEY=change-me

# order maths
SHIPPING_FLAT=6.5
FREE_SHIPPING_OVER=75
TAX_RATE=0
