# Where the NestJS API lives, as seen FROM THE ADMIN SERVER, not from a browser.
# Deliberately not NEXT_PUBLIC_*: the admin app is a backend-for-frontend, every
# API call is made server side, and the session token must never reach the client
# bundle. In production this can be a private/internal address.
API_INTERNAL_URL=http://localhost:4000/api/v1

# Name of the session cookie. Only worth changing if two INKHAUS environments
# ever share a hostname.
SESSION_COOKIE_NAME=inkhaus_admin

# --------------------------------------------------------------- Google OAuth
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). The secret lives here and only here; the API needs the id
# alone, to check the `aud` claim.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public origin of THIS app. The redirect URI is derived from it as
# <origin>/auth/google/callback and must match a registered redirect URI on the
# OAuth client character for character.
ADMIN_PUBLIC_URL=http://localhost:4322

# Test-only escape hatch: sends the browser to a local OIDC stub instead of
# Google so the e2e suite can walk the real flow offline. Both are IGNORED when
# NODE_ENV is production (see src/lib/google.ts) - an endpoint override is a
# redirect to someone else's consent screen.
GOOGLE_AUTH_ENDPOINT=
GOOGLE_TOKEN_ENDPOINT=
