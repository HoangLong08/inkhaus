# =============================================================================
# INKHAUS - the one env file
# =============================================================================
# Every app in this monorepo reads THIS file and no other. `packages/env` finds
# the repo root and loads it, so it does not matter whether you start a process
# from the root, from `apps/api` or from `apps/web`.
#
#   cp .env.example .env
#
# `.env.local`, `.env.development` and `.env.production` also work, in the same
# order Next.js uses, and all of them live here at the root too. Anything
# already exported in your shell (or set by Docker, CI or Playwright) always
# beats what is written here.
#
# Two things worth knowing:
#
#   * Values are taken LITERALLY - there is no `$VAR` expansion. A password like
#     `pa$$w` arrives intact rather than truncated to `pa`.
#   * NODE_ENV is deliberately absent. The tooling sets it (`next dev` means
#     development, `next build` means production, Playwright means test) and
#     pinning it in a file shared by four processes gets one of them wrong.
#
# Because this file is shared, every process can read every value in it -
# including GOOGLE_CLIENT_SECRET. Nothing here is sent to a browser unless its
# name starts with NEXT_PUBLIC_, but if you ever need a secret that the
# storefront must not even be able to read, that is the moment to give it its
# own file again.
# =============================================================================


# ------------------------------------------------------------------ apps/api
# PostgreSQL - matches docker-compose.yml
DATABASE_URL="postgresql://inkhaus:inkhaus@localhost:5432/inkhaus?schema=public"

# The API's own port. Named API_PORT rather than PORT because a bare PORT in a
# shared file is read by the Next apps too, and one of them would end up trying
# to bind 4000. A hosting platform that injects PORT is still honoured: the API
# reads API_PORT first and falls back to PORT.
API_PORT=4000
API_PREFIX=api

# Comma separated list of allowed browser origins. The admin app is NOT here on
# purpose: it calls this API server-to-server, so no browser origin needs a grant.
CORS_ORIGIN=http://localhost:4321

# How long an admin session token stays valid.
ADMIN_SESSION_TTL_HOURS=12

# How long a STOREFRONT session stays valid, in days rather than hours. A
# shopper coming back next week to check an order should still be signed in; a
# session that can see every order in the system should not be. Different blast
# radius, different number.
CUSTOMER_SESSION_TTL_DAYS=30

# Sign-in is Google-only. This list IS the allowlist: `npm run db:seed` creates
# an OWNER row per address, and a Google account with no row here cannot get in.
ADMIN_BOOTSTRAP_EMAILS=hoangnguyenitvn@gmail.com,longnguyen.080400@gmail.com

# Order maths. Blank falls back to the numbers in packages/shared.
SHIPPING_FLAT=6.5
FREE_SHIPPING_OVER=75
TAX_RATE=0


# --------------------------------------------------- apps/admin AND apps/web
# Where the NestJS API lives, as seen FROM A NEXT SERVER, not from a browser.
# Deliberately not NEXT_PUBLIC_*: both Next apps run their sign-in as a
# backend-for-frontend, every authenticated call is made server side, and no
# session token may reach a client bundle. In production this can be a
# private/internal address.
API_INTERNAL_URL=http://localhost:4000/api/v1


# ---------------------------------------------------------------- apps/admin
# Name of the session cookie. Only worth changing if two INKHAUS environments
# ever share a hostname.
SESSION_COOKIE_NAME=inkhaus_admin

# Public origin of the admin app. The redirect URI is derived from it as
# <origin>/api/auth/google/callback and must match a registered redirect URI on the
# OAuth client character for character.
ADMIN_PUBLIC_URL=http://localhost:4322


# ------------------------------------------------------------------ apps/web
# Where the NestJS API lives, as seen from a customer's browser. NEXT_PUBLIC_*
# is inlined into the client bundle at build time - never put a secret here.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Public origin of the storefront. Two jobs, one value: `metadataBase` for
# absolute OG/canonical URLs, and the Google redirect URI, derived from it as
# <origin>/api/auth/google/callback - which must match a registered redirect URI
# on the OAuth client character for character. Public by nature, hence the
# NEXT_PUBLIC_ prefix; an origin is not a secret.
NEXT_PUBLIC_SITE_URL=http://localhost:4321

# Name of the storefront session cookie. It MUST differ from
# SESSION_COOKIE_NAME above: cookies are not scoped by port, so on localhost a
# shared name would have signing into the shop sign you out of the back office.
WEB_SESSION_COOKIE_NAME=inkhaus_session


# ------------------------------------------------------------- Google OAuth
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). One client, read by three apps: both Next apps run the
# OAuth dance and need both halves, the API only checks the `aud` claim and so
# needs the id alone. That duplication is exactly what this file removes.
#
# One client serving both the shop and the back office is safe because the
# allowlist, not the client, is what separates them: an id_token minted for a
# shopper is accepted at /auth/google and refused at /admin/auth/google, which
# has no row for that address. Register BOTH redirect URIs on it:
#   http://localhost:4321/api/auth/google/callback   (storefront)
#   http://localhost:4322/api/auth/google/callback   (back office)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Test-only escape hatches. They send the OAuth dance and the id_token
# verification to a local OIDC stub so the e2e suite can run offline, and all
# four are IGNORED when NODE_ENV is production - an issuer override aimed at
# someone else's keys would make every forged token valid. Leave them blank;
# `npm run test:e2e` sets them per process, it does not read them from here.
GOOGLE_AUTH_ENDPOINT=
GOOGLE_TOKEN_ENDPOINT=
GOOGLE_ISSUER=
GOOGLE_JWKS_URL=


# ------------------------------------------------------ optional / defaulted
# Everything below has a working default in code. Uncomment only to change it.

# Sign-ins allowed per minute per IP, before the API starts refusing.
# ADMIN_LOGIN_RATE_LIMIT=10

# A design POSTs its fabric scene plus a mockup data-url per side; express'
# 100 kB default rejects any real artwork as a 413.
# JSON_BODY_LIMIT=12mb

# Canonical origin used for the storefront's metadata and og: tags.
# NEXT_PUBLIC_SITE_URL=https://inkhaus.example

# Panic switch: serve product photography as-is if the image optimizer ever
# misbehaves in production.
# IMAGES_UNOPTIMIZED=1

# Cache-busts the service worker when the platform does not set
# VERCEL_GIT_COMMIT_SHA.
# GIT_COMMIT_SHA=

# Used by the scripts in apps/web/scripts - the running storefront and API they
# drive a real browser against, and the Chrome to drive.
# SITE_ORIGIN=http://localhost:4321
# API_ORIGIN=http://localhost:4000/api/v1
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
