{
  "name": "inkhaus",
  "version": "0.1.0",
  "private": true,
  "description": "INKHAUS monorepo - Next.js storefront + admin back office + NestJS/Prisma/PostgreSQL API",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n shared,api,web,admin -c gray,magenta,cyan,yellow \"npm:dev:shared\" \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:admin\"",
    "dev:shared": "npm run dev -w @inkhaus/shared",
    "dev:api": "npm run dev -w @inkhaus/api",
    "dev:web": "npm run dev -w @inkhaus/web",
    "dev:admin": "npm run dev -w @inkhaus/admin",
    "build": "npm run build -w @inkhaus/shared && npm run build -w @inkhaus/api && npm run build -w @inkhaus/web && npm run build -w @inkhaus/admin",
    "build:shared": "npm run build -w @inkhaus/shared",
    "start:api": "npm run start -w @inkhaus/api",
    "start:web": "npm run start -w @inkhaus/web",
    "start:admin": "npm run start -w @inkhaus/admin",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "npm run prisma:generate -w @inkhaus/api",
    "db:migrate": "npm run prisma:migrate -w @inkhaus/api",
    "db:deploy": "npm run prisma:deploy -w @inkhaus/api",
    "db:seed": "npm run db:seed -w @inkhaus/api",
    "db:studio": "npm run prisma:studio -w @inkhaus/api",
    "db:reset": "npm run prisma:reset -w @inkhaus/api",
    "setup": "npm install && npm run build:shared && npm run db:generate"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=20.11"
  }
}
